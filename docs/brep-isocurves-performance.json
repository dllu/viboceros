  "probe_source": [
    "use super::*;",
    "use super::mass_properties::tests::{paraboloid, round_trim};",
    "use std::{hint::black_box, time::Instant};",
    "",
    "#[test]",
    "fn local_isocurve_performance_probe() {",
    "    for round in 0..3 {",
    "        for (name, radii) in [(\"disk\", vec![0.5]), (\"annulus\", vec![0.5, 0.25])] {",
    "            let brep = round_trim(paraboloid(), &radii, false);",
    "            for density in [0, 1, 3, 5] {",
    "                let run = || {",
    "                    if density == 0 {",
    "                        let mut curves = Vec::new();",
    "                        for fixed in [0., 0.125, 0.375] {",
    "                            curves.extend(brep.faces[0].isocurve_u_segments(fixed, Tolerance::DEFAULT).unwrap());",
    "                            curves.extend(brep.faces[0].isocurve_v_segments(fixed, Tolerance::DEFAULT).unwrap());",
    "                        }",
    "                        curves",
    "                    } else {",
    "                        brep.wireframe_curves(density, Tolerance::DEFAULT).unwrap()",
    "                    }",
    "                };",
    "                let result = black_box(run());",
    "                let bits = result.iter().flat_map(|c| {",
    "                    let mut numbers = vec![c.degree() as u64, c.control_points().len() as u64, c.knots().len() as u64];",
    "                    numbers.extend(c.knots().iter().map(|k| k.to_bits()));",
    "                    for control in c.control_points() {",
    "                        numbers.extend(control.point().to_array().map(f64::to_bits));",
    "                        numbers.push(control.weight().to_bits());",
    "                    }",
    "                    for t in [0., 0.125, 0.3, 0.5, 0.875, 1.] {",
    "                        numbers.extend(c.evaluate(c.parameter_at(t).unwrap()).unwrap().to_array().map(f64::to_bits));",
    "                    }",
    "                    numbers",
    "                }).collect::<Vec<_>>();",
    "                let start = Instant::now();",
    "                for _ in 0..1000 { black_box(run()); }",
    "                println!(\"WIRE_BENCH {{\\\"round\\\":{round},\\\"fixture\\\":\\\"{name}\\\",\\\"density\\\":{density},\\\"iterations\\\":1000,\\\"elapsed_ns\\\":{},\\\"geometry\\\":{bits:?}}}\", start.elapsed().as_nanos());",
    "            }",
    "        }",
    "    }",
    "}"
  ]
}
