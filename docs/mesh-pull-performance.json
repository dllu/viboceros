    "native_command_and_oracle_lint": "All targets, warnings denied",
    "python_geometry_and_provenance_tests": 10,
    "formatting_and_diff_whitespace": "Passed"
  },
  "limitations": [
    "The prior 24x24 grid workload failed its work budget; the new version succeeds at unchanged limits. This does not establish support for every dense mesh.",
