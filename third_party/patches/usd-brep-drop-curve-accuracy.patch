 //   Local static routines for DropCurve().
 // 
 // **********************************************************************
+
+// Keep crossings as test stations, without the interval classification's
+// merging of nearby boundaries. A short UV span may cover a large 3D feature.
+static SmStatus sm_DropTestBreaks(SmHermiteCurve &hermite, const SmSurface &surface,
+                                  const SmContext &context, SmTArray<double> &breaks)
+{
+  SmBSplineCurve *rawUV = NULL;
+  SER(SmBSplineCurve::CreateFromHermiteCurve(context, hermite, rawUV, 0.0, 1.0));
+  std::unique_ptr<SmBSplineCurve> ownedUV(rawUV);
+  const SmCurve &uv = *ownedUV;
+  SER(uv.GetKnots(breaks));
+  const SmExtent1d interval = uv.GetNaturalInterval();
+  const SmExtent2d domain = surface.GetNaturalUVDomain();
+  SmPoint3d controls[4];
+  hermite.GetBezierPoints(controls[0], controls[1], controls[2], controls[3]);
+  for (int axis = 0; axis < 2; ++axis)
+    {
+      double minimum = controls[0][axis], maximum = minimum;
+      for (int c = 1; c < 4; ++c)
+        {
+          minimum = std::min(minimum, controls[c][axis]);
+          maximum = std::max(maximum, controls[c][axis]);
+        }
+      SmTArray<double> knots;
+      SER(surface.GetKnots(axis == 0 ? SM_SP_U : SM_SP_V, knots));
+      for (ULONG i = 1; i + 1 < knots.GetSize(); ++i)
+        {
+          const double k = knots[i];
+          if (k <= minimum || k >= maximum) continue;
+          SmPoint3d a(axis == 0 ? k : domain.GetMin().x,
+                       axis == 0 ? domain.GetMin().y : k, 0);
+          SmPoint3d b(axis == 0 ? k : domain.GetMax().x,
+                       axis == 0 ? domain.GetMax().y : k, 0);
+          SmLine *raw = NULL;
+          SER(SmLine::CreateLineSegment(context, 2, a, b, raw));
+          std::unique_ptr<SmLine> line(raw);
+          SmSolutionArray solutions;
+          SmBoolean more = TRUE;
+          SER(uv.IntersectWithLine(interval, *line, line->GetNaturalInterval(),
+                                   SmTol::GetEffZeroParam(), more, solutions));
+          if (more)
+            SER(uv.GlobalCurveIntersect(interval, *line, line->GetNaturalInterval(),
+                                        SmTol::GetEffZeroParam(), solutions));
+          for (ULONG j = 0; j < solutions.GetSize(); ++j)
+            {
+              const double t = solutions[j].m_vStart[0];
+              if (interval.GetMin() < t && t < interval.GetMax()) breaks.Add(t);
+            }
+        }
+    }
+  if (breaks.GetSize() < 2) return SM_ERR_NOT_WITHIN_TOLERANCE;
+  std::sort(&breaks[0], &breaks[0] + breaks.GetSize());
+  // Remove exact duplicates only; nearby crossings may bound a real feature.
+  ULONG count = 1;
+  for (ULONG i = 1; i < breaks.GetSize(); ++i)
+    if (breaks[i] > breaks[count - 1]) breaks[count++] = breaks[i];
+  breaks.SetSize(count);
+  return SM_SUCCESS;
+}
 
