+    /* Classify valid parameters exactly. The general span/multiplicity helper
+       assumes clamped ends and skips short endpoint spans by tolerance. */
+    {
+        NL_REAL *K = fixedBasis->U;
+        if( t GE K[fixedDegree] AND t LE K[fixedCount] )
+        {
+            NL_REAL *first = std::lower_bound(K, K + fixedBasis->m + 1, t);
+            NL_REAL *last = std::upper_bound(first, K + fixedBasis->m + 1, t);
+            fixedMult = (NL_INDEX)(last - first);
+            fixedSpan = (NL_INDEX)((t EQ K[fixedCount] ? first : last) - K) - 1;
+            if( fixedMult EQ fixedDegree + 1 )
+            {
+                /* Right limit at starts/interior breaks; left limit at end.
+                   Inactive padding can put this row away from either edge. */
+                isolatedRow = (NL_INDEX)(first - K) - (t EQ K[fixedCount] ? 1 : 0);
+                if( isolatedRow LT 0 OR isolatedRow GE fixedCount )
+                    NL_ERROR( NL_IND_ERR );
+            }
+            else if( t EQ K[fixedCount] )
+            {
+                /* The end knot is to the right of the chosen span. Use the
+                   full existing de Boor reduction, not an assumed end row. */
+                fixedMult = 0;
+            }
+        }
+        else
+        {
+            /* Preserve the existing extrapolation policy outside the domain. */
+            error = N_BasisFindSpanAndMult(fixedBasis, fixedDegree, t, NL_LEFT,
+                                           &fixedSpan, &fixedMult);
+            if( error EQ NL_YES )
+                NL_OUT;
+        }
+        if( dir EQ NL_UDIR ) { spv = fixedSpan; mlv = fixedMult; }
+        else                 { spu = fixedSpan; mlu = fixedMult; }
+    }
