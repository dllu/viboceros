+// Parameter proximity alone (1/10000 of a domain) can merge distinct crossings.
+// Compare physical uncertainty scaled by the intersection angle for point pairs.
+SmSolutionPairType SmCCIGlobalSolver::IdenticalSolutions(
+    const SmSolution &a,const SmSolution &b,const SmSolution *&preferred) const {
+  const auto kind=SmGlobalSolver::IdenticalSolutions(a,b,preferred);
+  if(kind!=SM_SP_IDENTICAL || m_bDoProjection || a.m_lNumObjects!=2
+      || a.m_eSolutionType!=SM_ST_SINGLE_VALUE)return kind;
+  const auto *first=SM_CAST_PTR(SmCurve,a.m_apObjects[0]);
+  const auto *second=SM_CAST_PTR(SmCurve,a.m_apObjects[1]);
+  if(!first || !second) {preferred=NULL;return SM_SP_DIFFPARAMETERS;}
+  SmPoint3d pa[2],pb[2],qa[2],qb[2];
+  if(first->Evaluate(a.m_vStart[0],1,TRUE,pa,TRUE)!=SM_SUCCESS
+      || first->Evaluate(b.m_vStart[0],1,TRUE,pb,TRUE)!=SM_SUCCESS
+      || second->Evaluate(a.m_vStart[1],1,TRUE,qa,TRUE)!=SM_SUCCESS
+      || second->Evaluate(b.m_vStart[1],1,TRUE,qb,TRUE)!=SM_SUCCESS) {preferred=NULL;return SM_SP_DIFFPARAMETERS;}
+  SmVector3d ta=pa[1],tb=qa[1],ua=pb[1],ub=qb[1];
+  if(ta.Unitize()!=SM_SUCCESS || tb.Unitize()!=SM_SUCCESS
+      || ua.Unitize()!=SM_SUCCESS || ub.Unitize()!=SM_SUCCESS) {preferred=NULL;return SM_SP_DIFFPARAMETERS;}
+  const double uncertainty=m_d3dTolerance/smos_Max((ta*tb).Length(),SM_EFF_ZERO_SQRT)
+      + m_d3dTolerance/smos_Max((ua*ub).Length(),SM_EFF_ZERO_SQRT);
+  if(pa[0].DistanceBetween(pb[0])>uncertainty || qa[0].DistanceBetween(qb[0])>uncertainty) {
+    preferred=NULL;return SM_SP_DIFFPARAMETERS;
+  }
+  return kind;
+}
+
 
