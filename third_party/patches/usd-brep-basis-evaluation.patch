+// Evaluation needs an actual nonzero span, including at unclamped ends and
+// beside full-order groups. Keep the legacy span helpers used by editing
+// operations unchanged: their tolerance and indexing contracts are different.
+static NL_FLAG sm_BasisEvaluationSpan(NL_KNOTVECTOR *knt, NL_DEGREE p,
+                                    NL_PARAMETER u, NL_FLAG flg, NL_INDEX *spn)
+{
+    const NL_REAL *U = knt->U;
+    const NL_INDEX m = knt->m;
+    if (U[p] < U[m - p] && u >= U[p] && u <= U[m - p] &&
+        (flg == NL_LEFT || flg == NL_RIGHT))
+    {
+        if (u == U[p] && U[p] < U[p + 1])
+            *spn = p;
+        else if (u == U[m - p] && U[m - p - 1] < U[m - p])
+            *spn = m - p - 1;
+        else if (u == U[p] || (u != U[m - p] && flg == NL_LEFT))
+            *spn = std::upper_bound(U, U + m + 1, u) - U - 1;
+        else
+            *spn = std::lower_bound(U, U + m + 1, u) - U - 1;
+        return NL_NO;
+    }
+    return N_BasisFindSpan(knt, p, u, flg, spn);
+}
