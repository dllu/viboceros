# Compose exact rectangular restriction with the existing isocurve repairs.
foreach(patch_kind IN ITEMS Region Output)
    if(patch_kind STREQUAL "Region")
        set(patch_source "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/NL_SrfTool.cpp")
        set(patch_file "${CMAKE_CURRENT_SOURCE_DIR}/../../../third_party/patches/usd-brep-surface-patch-region.patch")
        set(patch_output "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/NL_SrfToolPatch.cpp")
    else()
        set(patch_source "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmBSplineSurfaceIso.cpp")
        set(patch_file "${CMAKE_CURRENT_SOURCE_DIR}/../../../third_party/patches/usd-brep-surface-patch-output.patch")
        set(patch_output "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmBSplineSurfacePatch.cpp")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch_file}")
    execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --fuzz=0 -o "${patch_output}" "${patch_source}" "${patch_file}"
                    RESULT_VARIABLE patch_status)
    if(NOT patch_status EQUAL 0)
        message(FATAL_ERROR "usd-brep exact patch ${patch_kind} repair failed; review the pinned source")
    endif()
    list(REMOVE_ITEM KERNEL_SOURCES "${patch_source}")
    list(APPEND KERNEL_SOURCES "${patch_output}")
endforeach()
