+    /* Restriction needs exact groups, including unclamped active ends.
+       Keep the previous span policy for extrapolation outside the domain. */
+    auto exactGroup = [](NL_KNOTVECTOR *knots, NL_DEGREE degree, NL_PARAMETER t,
+                         NL_INDEX *span, NL_INDEX *multiplicity) -> NL_FLAG
+    {
+        NL_REAL *K = knots->U;
+        if( t GE K[degree] AND t LE K[knots->m - degree] )
+        {
+            NL_REAL *first = std::lower_bound(K, K + knots->m + 1, t);
+            NL_REAL *last = std::upper_bound(first, K + knots->m + 1, t);
+            *span = (NL_INDEX)(last - K) - 1;
+            *multiplicity = (NL_INDEX)(last - first);
+            return NL_NO;
+        }
+        return N_BasisFindSpanAndMult(knots, degree, t, NL_LEFT, span, multiplicity);
+    };
 
