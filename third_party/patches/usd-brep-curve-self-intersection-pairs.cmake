# Apply after the curve intersection convergence repairs.
set(SELF_INTERSECTION_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmCurve.cpp")
set(SELF_INTERSECTION_PATCH "${CMAKE_CURRENT_LIST_DIR}/usd-brep-curve-self-intersection-pairs.patch")
set(SELF_INTERSECTION_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmCurveSelfPairs.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SELF_INTERSECTION_PATCH}")
execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --fuzz=0 -o "${SELF_INTERSECTION_OUTPUT}"
  "${SELF_INTERSECTION_SOURCE}" "${SELF_INTERSECTION_PATCH}"
  RESULT_VARIABLE SELF_STATUS OUTPUT_VARIABLE SELF_OUTPUT ERROR_VARIABLE SELF_ERROR)
if(NOT SELF_STATUS EQUAL 0)
  message(FATAL_ERROR "Curve self-intersection patch failed: ${SELF_OUTPUT} ${SELF_ERROR}")
endif()
list(REMOVE_ITEM KERNEL_SOURCES "${SELF_INTERSECTION_SOURCE}")
list(APPEND KERNEL_SOURCES "${SELF_INTERSECTION_OUTPUT}")
