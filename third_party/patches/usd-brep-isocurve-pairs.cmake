# Preserve native extraction data and construct its coordinate-space partner.
foreach(iso_kind IN ITEMS Surface UV)
    if(iso_kind STREQUAL "Surface")
        set(iso_source "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmBSplineSurfaceUV.cpp")
        set(iso_patch "${CMAKE_CURRENT_SOURCE_DIR}/../../../third_party/patches/usd-brep-isocurve-output-basis.patch")
        set(iso_output "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmBSplineSurfaceIso.cpp")
    else()
        set(iso_source "${USD_BREP_ROOT}/source/SMLib/src/SmIsoCurve.cpp")
        set(iso_patch "${CMAKE_CURRENT_SOURCE_DIR}/../../../third_party/patches/usd-brep-isocurve-uv-line.patch")
        set(iso_output "${CMAKE_CURRENT_BINARY_DIR}/usd-brep-patched/SmIsoCurve.cpp")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${iso_patch}")
    execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --fuzz=0 -o "${iso_output}" "${iso_source}" "${iso_patch}"
                    RESULT_VARIABLE iso_patch_status)
    if(NOT iso_patch_status EQUAL 0)
        message(FATAL_ERROR "usd-brep ${iso_kind} isocurve pair repair failed; review the pinned source")
    endif()
    list(REMOVE_ITEM KERNEL_SOURCES "${iso_source}")
    list(APPEND KERNEL_SOURCES "${iso_output}")
endforeach()
